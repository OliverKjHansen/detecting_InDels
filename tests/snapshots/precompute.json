  ],
  "spec": "\n                mkdir -p {ROOT}/output/precomute/ape/s1/unresolved_haplotypes/chunks\n                python {ROOT}/scripts/resolve_haplotypes.py c1 0 12000000 {ROOT}/bam/ape/s1/kinetics/s1_kinetics_diploid.bam {ROOT}/fasta/ape/s1/diploid_assembly/s1_diploid.fa {ROOT}/output/precomute/ape/s1/avg_coverage.txt --min-base-quality 40 --min-reads 2 > {ROOT}/output/precomute/ape/s1/unresolved_haplotypes/chunks/c1_0_12000000.bed\n                "
 },
