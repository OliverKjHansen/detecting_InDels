{
 "average_coverage_ape_s1": {
  "inputs": [
   "{ROOT}/bam/ape/s1/kinetics/s1_kinetics_diploid.bam",
   "{ROOT}/fasta/ape/s1/diploid_assembly/s1_diploid.fa.fai"
  ],
  "options": {
   "account": "mutationalscanning",
   "cores": 8,
   "memory": "100g",
   "walltime": "08:00:00"
  },
  "outputs": [
   "{ROOT}/output/precomute/ape/s1/long_contigs.bed",
   "{ROOT}/output/precomute/ape/s1/avg_coverage.txt"
  ],
  "spec": "\n        mkdir -p {ROOT}/output/precomute/ape/s1\n        awk -v min=1000000 'BEGIN {OFS=\"\\t\"} $2 > min {print $1, 0, $2}' {ROOT}/fasta/ape/s1/diploid_assembly/s1_diploid.fa.fai > {ROOT}/output/precomute/ape/s1/long_contigs.bed\n        samtools depth -b {ROOT}/output/precomute/ape/s1/long_contigs.bed {ROOT}/bam/ape/s1/kinetics/s1_kinetics_diploid.bam | awk '{sum += $3; count++} END {print sum / count}' > {ROOT}/output/precomute/ape/s1/avg_coverage.txt\n        "
 },
 "average_coverage_ape_s2": {
  "inputs": [
