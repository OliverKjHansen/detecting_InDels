 "merge_unresolved_ape_s1_c1_diploid": {
  "inputs": [
   "{ROOT}/output/precomute/ape/s1/unresolved_haplotypes/chunks/c1_0_12000000.bed"
  ],
  "options": {
   "account": "mutationalscanning",
   "cores": 1,
   "memory": "4g",
   "walltime": "00:30:00"
  },
  "outputs": [
   "{ROOT}/output/precomute/ape/s1/unresolved_haplotypes/c1.bed"
  ],
  "spec": "\n            cat {ROOT}/output/precomute/ape/s1/unresolved_haplotypes/chunks/c1_0_12000000.bed | sort -k1,1 -k2,2n | bedtools merge -i - > {ROOT}/output/precomute/ape/s1/unresolved_haplotypes/c1.bed\n            "
 },
