 "sorting_tissue_classification_ape_s1_diploid": {
  "inputs": [
   "{ROOT}/read_labels/ape/s1/s1_read_labels.txt"
  ],
  "options": {
   "account": "mutationalscanning",
   "cores": 4,
   "memory": "40g",
   "walltime": "12:00:00"
  },
  "outputs": [
   "{ROOT}/output/precomute/ape/s1/sorted_tissue_classification.tsv"
  ],
  "spec": "\n            mkdir -p {ROOT}/output/precomute/ape/s1\n            printf \"readID\\ttissue\\n\" > {ROOT}/output/precomute/ape/s1/sorted_tissue_classification.tsv\n            awk -v OFS=\"\\t\" '{gsub(/[ \\t]+/, \"\\t\"); print $1, $2}' {ROOT}/read_labels/ape/s1/s1_read_labels.txt | sort -k1,1 >> {ROOT}/output/precomute/ape/s1/sorted_tissue_classification.tsv\n            "
 },
