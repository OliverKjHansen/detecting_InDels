  ],
  "options": {
   "account": "mutationalscanning",
   "cores": 1,
   "memory": "20g",
   "walltime": "04:00:00"
  },
  "outputs": [
   "{ROOT}/output/nonrepetitive_indels/ape/s1/merged/indels.tsv"
  ],
  "spec": "\n        mkdir -p {ROOT}/output/nonrepetitive_indels/ape/s1/merged\n        python {ROOT}/scripts/filtering_haploid_mapping.py {ROOT}/output/nonrepetitive_indels/ape/s1/calls/c1.tsv {ROOT}/output/nonrepetitive_indels/ape/s1/calls/c2.tsv {ROOT}/output/nonrepetitive_indels/ape/s1/haploid/locations.tsv {ROOT}/output/nonrepetitive_indels/ape/s1/haploid/all.fastq.gz --haplotype hap1={ROOT}/output/nonrepetitive_indels/ape/s1/haploid/hap1_locations.tsv --haplotype hap2={ROOT}/output/nonrepetitive_indels/ape/s1/haploid/hap2_locations.tsv > {ROOT}/output/nonrepetitive_indels/ape/s1/merged/indels.tsv.tmp\n        awk 'NR==1 {print $0 \"\\t\" \"species\" \"\\t\" \"sample\"}; NR>1 {print $0 \"\\t\" \"ape\" \"\\t\" \"s1\"}' {ROOT}/output/nonrepetitive_indels/ape/s1/merged/indels.tsv.tmp > {ROOT}/output/nonrepetitive_indels/ape/s1/merged/indels.tsv\n        rm -f {ROOT}/output/nonrepetitive_indels/ape/s1/merged/indels.tsv.tmp\n        "
 },
