   "{ROOT}/output/nonrepetitive_indels/ape/s1/haploid/remapped.bam",
   "{ROOT}/output/nonrepetitive_indels/ape/s1/haploid/locations.tsv"
  ],
  "spec": "\n        mkdir -p {ROOT}/output/nonrepetitive_indels/ape/s1/haploid\n        cat {ROOT}/output/nonrepetitive_indels/ape/s1/fastq/c1.fastq.gz {ROOT}/output/nonrepetitive_indels/ape/s1/fastq/c2.fastq.gz > {ROOT}/output/nonrepetitive_indels/ape/s1/haploid/all.fastq.gz\n        pbmm2 align {ROOT}/fasta/ape/s1/haploid_assembly/s1_haploid.fa {ROOT}/output/nonrepetitive_indels/ape/s1/haploid/all.fastq.gz {ROOT}/output/nonrepetitive_indels/ape/s1/haploid/remapped.bam --preset HIFI --sort -j 12 -J 4 -m 8G && samtools view {ROOT}/output/nonrepetitive_indels/ape/s1/haploid/remapped.bam | awk -v OFS='\\t' '{print $1,$2,$3,$4,$5,$6}' | sort -k1,1 > {ROOT}/output/nonrepetitive_indels/ape/s1/haploid/locations.tsv\n        "
 },
